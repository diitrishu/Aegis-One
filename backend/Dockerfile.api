# One image for all Python services; docker-compose picks the command.
# Build context is the repository root (the API reads rasters from dataa/ too).
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY backend/requirements.api.txt backend/requirements.api.txt
RUN pip install --no-cache-dir -r backend/requirements.api.txt

COPY backend/*.py backend/
COPY backend/data backend/data
COPY dataa/datasets dataa/datasets

WORKDIR /app/backend
ENV PYTHONUNBUFFERED=1
EXPOSE 5000 5052 8081 8082

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:5000/api/health || exit 1

CMD ["python", "simple_disaster_api.py"]
