# Routing service only. Build context is the repository root.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY backend/requirements.routing.txt backend/requirements.routing.txt
RUN pip install --no-cache-dir -r backend/requirements.routing.txt

COPY backend/geo_layers.py backend/road_graph.py backend/routing_api.py backend/
COPY backend/data/up_india_complete.gpkg backend/data/up_india_complete.gpkg
COPY backend/data/routing backend/data/routing
COPY dataa/datasets/population/processed dataa/datasets/population/processed

WORKDIR /app/backend
EXPOSE 8082
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8082/health || exit 1
CMD ["python", "routing_api.py"]
